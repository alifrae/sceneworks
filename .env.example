# ---- SceneWorks backend settings (copy to backend/.env) ----

# Host/port for the FastAPI server
SCENEWORKS_HOST=127.0.0.1
SCENEWORKS_PORT=8010

# SQLite database location (relative paths resolve from the backend directory)
SCENEWORKS_DATABASE_URL=sqlite+aiosqlite:///./data/sceneworks.db

# Where SceneWorks creates isolated task and MCP EngineeringSession worktrees.
# Must be outside any managed repository.
# Windows: C:/Users/you/sceneworks-worktrees
# Linux/macOS: /home/you/sceneworks-worktrees
SCENEWORKS_WORKTREE_ROOT=

# Default delegated agent worker. Gemini ACP remains the recommended default.
# Options: gemini_acp, opencode, openhands, fake (testing only)
SCENEWORKS_DEFAULT_BACKEND=gemini_acp

# ---- Provider-neutral model profiles ----
# Roles request intent such as strongest/coding/research. Optionally map each
# profile to a concrete backend and/or model. Empty/unmapped profiles preserve
# the role backend and that backend's configured default model.
# SCENEWORKS_MODEL_PROFILE_ROUTES={"strongest":{"backend":"gemini_acp","model":"<strong-model>"},"coding":{"backend":"opencode","model":"<provider/model>"},"research":{"backend":"gemini_acp","model":"<research-model>"}}

# ---- Gemini ACP backend (default) ----
# Leave unset to auto-discover "gemini" on PATH.
# SCENEWORKS_GEMINI_EXECUTABLE=gemini
# SCENEWORKS_GEMINI_MODEL=          # unset = CLI auto
# SCENEWORKS_GEMINI_EXTRA_ARGS=[]
# SCENEWORKS_GEMINI_STARTUP_TIMEOUT_SECONDS=120

# ---- OpenCode backend (non-ACP backup) ----
# SceneWorks uses `opencode run --auto --dir <worktree>` for this adapter. OpenCode
# owns provider authentication/configuration; SceneWorks only selects an optional
# provider/model string and agent profile.
# SCENEWORKS_OPENCODE_EXECUTABLE=opencode
# SCENEWORKS_OPENCODE_MODEL=<provider/model>
# SCENEWORKS_OPENCODE_AGENT=
# SCENEWORKS_OPENCODE_EXTRA_ARGS=[]
# SCENEWORKS_OPENCODE_ENVIRONMENT={}

# ---- OpenHands backend (optional, EXPERIMENTAL) ----
# Install first:  cd backend && uv sync --extra openhands
# See docs/backends.md for matching SDK/tools versions and current limitations.
# SCENEWORKS_OPENHANDS_MODEL=lm_studio/google/gemma-4-e2b
# SCENEWORKS_OPENHANDS_BASE_URL=http://127.0.0.1:1234/v1
# SCENEWORKS_OPENHANDS_API_KEY=
# SCENEWORKS_OPENHANDS_URL=http://localhost:8000
# SCENEWORKS_OPENHANDS_EXECUTABLE=openhands
# SCENEWORKS_OPENHANDS_MODE=local
# SCENEWORKS_OPENHANDS_MAX_ITERATIONS=40

# ---- MCP / ChatGPT reasoning and engineering-control interface ----
# Stateless SceneWorks MCP endpoint: POST http://127.0.0.1:8010/mcp
# Keep SceneWorks on localhost and use ChatGPT's trusted Tunnel option for a
# local/private instance. The bare SceneWorks API does not implement OAuth and
# must not be published directly to the internet.
SCENEWORKS_MCP_ENABLED=true

# Operating modes:
#   observe  = semantic project/task/evidence reads only
#   standard = Observe + governed actions + host-visible Git project registration
#   advanced = Standard + provider-neutral EngineeringSessions with direct
#              workspace/command/process/Git, semantic PCS control, optional
#              agent delegation and managed-PCS GUI evidence/automation when permitted
SCENEWORKS_MCP_MODE=observe

# Legacy WP11 prototype compatibility only. Prefer SCENEWORKS_MCP_MODE.
SCENEWORKS_MCP_ALLOW_ACTIONS=false

# Advanced-mode capability ceiling. Direct EngineeringSessions request a subset.
# `external_asset_read` allows explicit read-only PCS recording/corpus aliases.
# `gui_observe` allows managed-PID window/dialog discovery and screenshot evidence.
# `gui_automate` is separate and additionally allows Windows UI Automation
# Invoke/Value/SelectionItem/Toggle patterns on controls discovered under the
# live managed PCS window. WP18 does NOT expose coordinate clicking, keyboard
# injection, arbitrary HWND/PID targeting or arbitrary desktop automation.
# `subagents` is retained only for legacy Gemini ACP provider sessions.
SCENEWORKS_ADVANCED_SESSION_PERMISSIONS=["repository_read","repository_write","shell_execute","process_control","git_commit","network_access","agent_delegate","external_asset_read","gui_observe","gui_automate","subagents"]

# GUI screenshots are stored as bounded SceneWorks-owned evidence under the
# project storage tree, outside Git worktrees. They can contain visually
# sensitive PCS content, so grant gui_observe/gui_automate only when required.
# SCENEWORKS_GUI_SCREENSHOT_MAX_BYTES=8000000

# IMPORTANT: file operations are confined to the isolated EngineeringSession
# worktree. Commands/processes are NOT an OS sandbox; they inherit the SceneWorks
# user's OS authority. A shell-capable process can potentially access the network
# even when a separate network flag is not granted unless the host/container is
# sandboxed independently.

# Maximum text returned by one MCP tool call.
SCENEWORKS_MCP_TOOL_MAX_CHARS=120000

# ---- Execution ----
SCENEWORKS_EXECUTION_TIMEOUT_SECONDS=5400
SCENEWORKS_CANCEL_GRACE_SECONDS=15
SCENEWORKS_GIT_TIMEOUT_SECONDS=300

# ---- Workflow ----
SCENEWORKS_MAX_REVIEW_ITERATIONS=3
SCENEWORKS_CHECKPOINT_DB_PATH=data/workflow_checkpoints.db

# ---- Context limits ----
SCENEWORKS_CONTEXT_MAX_BYTES=200000
SCENEWORKS_CONTEXT_FILE_MAX_BYTES=60000

# ---- Logging ----
SCENEWORKS_LOG_LEVEL=INFO

# ---- CORS ----
SCENEWORKS_CORS_ORIGINS=["http://localhost:3000"]

# SSE event replay limit
SCENEWORKS_SSE_REPLAY_EVENTS=500
