# ---- SceneWorks backend settings (copy to backend/.env) ----

# Host/port for the FastAPI server
SCENEWORKS_HOST=127.0.0.1
SCENEWORKS_PORT=8010

# SQLite database location (relative paths resolve from the backend directory)
SCENEWORKS_DATABASE_URL=sqlite+aiosqlite:///./data/sceneworks.db

# Where SceneWorks creates isolated Git worktrees for agents.
# Must be outside any managed repository.
# Windows: C:/Users/you/sceneworks-worktrees
# Linux/macOS: /home/you/sceneworks-worktrees
SCENEWORKS_WORKTREE_ROOT=

# Default agent backend (gemini_acp, openhands, or fake)
SCENEWORKS_DEFAULT_BACKEND=gemini_acp

# ---- Provider-neutral model profiles (WP8) ----
# Roles request intent such as strongest/coding/research. Optionally map each
# profile to a concrete backend and/or model. Empty/unmapped profiles preserve
# the role backend and that backend's configured default model.
# The resolved backend/model is persisted on every Execution before it starts.
# JSON example (replace placeholders with models supported by your provider):
# SCENEWORKS_MODEL_PROFILE_ROUTES={"strongest":{"backend":"gemini_acp","model":"<strong-model>"},"coding":{"backend":"gemini_acp","model":"<coding-model>"},"research":{"backend":"openhands","model":"<research-model>"}}

# ---- Gemini ACP backend ----
# Leave unset to auto-discover "gemini" on PATH.
# SCENEWORKS_GEMINI_EXECUTABLE=gemini
# Model selection used when no profile-specific model is configured:
# SCENEWORKS_GEMINI_MODEL=          # unset = CLI auto
# SCENEWORKS_GEMINI_MODEL=auto      # explicit auto
# SCENEWORKS_GEMINI_MODEL=<alias>   # any supported Gemini CLI model/alias
# SCENEWORKS_GEMINI_EXTRA_ARGS=[]
# SCENEWORKS_GEMINI_STARTUP_TIMEOUT_SECONDS=120

# ---- OpenHands backend (optional, EXPERIMENTAL) ----
# Install first:  cd backend && uv sync --extra openhands
# openhands-sdk and openhands-tools versions MUST match; a mismatched pair
# installs cleanly and then fails at import. See docs/backends.md.
#
# Default litellm-form model id when no profile-specific model is configured.
# SCENEWORKS_OPENHANDS_MODEL=lm_studio/google/gemma-4-e2b
#
# LLM endpoint for any OpenAI-compatible server (LM Studio, vLLM, Ollama).
# This is the *model* endpoint, NOT the Agent Server.
# SCENEWORKS_OPENHANDS_BASE_URL=http://127.0.0.1:1234/v1
#
# Provider credential, if the endpoint needs one.
# SCENEWORKS_OPENHANDS_API_KEY=
#
# Agent Server URL. Setting this switches to `remote` mode, which is
# implemented but NOT validated: working_dir is a path in the *server's*
# filesystem, so a remote server does not see the local SceneWorks worktree.
# SCENEWORKS_OPENHANDS_URL=http://localhost:8000
#
# CLI/headless development fallback (NOT validated).
# SCENEWORKS_OPENHANDS_EXECUTABLE=openhands
#
# Force a mode instead of resolving one: local | remote | http | cli
# SCENEWORKS_OPENHANDS_MODE=local
#
# Upper bound on agent turns per execution (SDK default is 500).
# SCENEWORKS_OPENHANDS_MAX_ITERATIONS=40
#
# NOTE: on Windows the OpenHands V1 terminal tool raises NotImplementedError,
# so shell-using roles (notably the Engineer) cannot run in local mode. Only
# read-only roles are usable. Gemini ACP remains the default for all roles.

# ---- MCP / external reasoning clients (WP11) ----
# Stateless MCP endpoint: POST http://127.0.0.1:8010/mcp
# Keep SceneWorks on localhost and use ChatGPT's trusted Tunnel option for a
# local/private instance. The bare SceneWorks API does not implement OAuth and
# must not be published directly to the internet.
SCENEWORKS_MCP_ENABLED=true
# Connecting an MCP client grants read-only semantic inspection by default.
# Set true only when the connection is trusted and you want ChatGPT/external
# reasoning clients to create tasks, invoke roles, or advance task workflows.
SCENEWORKS_MCP_ALLOW_ACTIONS=false
# Maximum text returned by a single MCP semantic tool call. Large diffs and
# artifacts are explicitly truncated after this budget.
SCENEWORKS_MCP_TOOL_MAX_CHARS=120000

# ---- Execution ----
# Hard timeout for a single agent execution (seconds).
# 5400 s (90 min) covers multi-pass tool-calling loops on large codebases.
# Keep configurable — a small task should never need this much.
SCENEWORKS_EXECUTION_TIMEOUT_SECONDS=5400
# Grace period after cancellation before force-kill (seconds).
SCENEWORKS_CANCEL_GRACE_SECONDS=15
# Timeout for a single git command (seconds). Creating a worktree checks out
# the whole tree; on a typical repository that takes tens of seconds.
# fsmonitor is suppressed per-process so daemon accumulation does not slow
# git operations. Raise this only for exceptionally large repositories.
SCENEWORKS_GIT_TIMEOUT_SECONDS=300

# ---- Workflow ----
# Maximum review-repair iterations before forcing human intervention.
SCENEWORKS_MAX_REVIEW_ITERATIONS=3
# LangGraph checkpoint database path.
SCENEWORKS_CHECKPOINT_DB_PATH=data/workflow_checkpoints.db

# ---- Context limits ----
SCENEWORKS_CONTEXT_MAX_BYTES=200000
SCENEWORKS_CONTEXT_FILE_MAX_BYTES=60000

# ---- Logging ----
SCENEWORKS_LOG_LEVEL=INFO

# ---- CORS ----
SCENEWORKS_CORS_ORIGINS=["http://localhost:3000"]

# SSE event replay limit
SCENEWORKS_SSE_REPLAY_EVENTS=500
